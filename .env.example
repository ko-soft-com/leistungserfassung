VITE_JIRA_BASE_URL=https://your-jira.atlassian.net/browse/
VITE_PR_BASE_URL=https://github.com/your-org/your-repo/pull/

# Firebase Konfiguration (Firebase Console → Projekteinstellungen → Deine Apps → Web-App)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Lokale Entwicklung mit Firestore Emulator (firebase emulators:start --only firestore)
VITE_USE_EMULATOR=false
