rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // V3: Nur authentifizierte Nutzer
    // TODO(V4-Multi-User): request.auth.uid == resource.data.userId
    match /eintraege/{eintragId} {
      allow read, write: if request.auth != null;
    }

    match /tageszeiten/{datum} {
      allow read, write: if request.auth != null;
    }

  }
}
